# Docker ignore file for ChatPPT
# Exclude files and directories from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in container)
*.md
docs/
jupyter/
!README.md

# Test files
test/
src/tests/
test_*.py
*_test.py

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Logs
logs/
*.log
app.log

# Output files (mounted as volumes)
output/
*.pptx
*.docx

# Images (mounted as volumes)
images/
!images/.gitkeep

# Models (too large, should be downloaded at runtime or mounted)
models/*
!models/.gitkeep

# Environment files
.env
.env.local
.env.*.local

# OS files
Thumbs.db
.DS_Store

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Development scripts
fix_*.bat
install_*.bat
run_*.bat
check_*.py
demo_*.py
test_*.py

# Session data
session_*/

